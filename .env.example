# ===== 视觉识别（至少配一个 Provider）=====

# 豆包（火山方舟）：控制台开通视觉模型后获取 API Key
ARK_API_KEY=
# 豆包模型名或推理接入点 ID；若默认模型名在你的账号不可用，填方舟推理接入点 ID（如 ep-xxxxxxxx）
ARK_MODEL_ID=

# OpenAI 兼容
OPENAI_API_KEY=

# 通义千问 Qwen-VL（DashScope）
DASHSCOPE_API_KEY=

# 智谱 GLM-4V（BigModel）
ZHIPU_API_KEY=

# 自定义 OpenAI 兼容端点
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=

# 默认 Provider：doubao | openai | qwen | zhipu | custom（不填则按已有 Key 自动检测）
VISION_PROVIDER=

# ===== 语音识别（豆包 ASR，可选）=====
DOUBAO_APP_ID=
DOUBAO_TOKEN=
DOUBAO_CLUSTER=

# ===== 其他（可选）=====
# USAGE_LOG=usage.json
